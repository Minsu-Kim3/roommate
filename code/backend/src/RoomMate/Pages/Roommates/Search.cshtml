@* Roommate search page: lists compatible students, best match first. *@
@page
@model RoomMate.Pages.Roommates.SearchModel
@{
    ViewData["Title"] = "Find Roommates";
}

<h2>Find Roommates</h2>

@if (!Model.HasProfile)
{
    <p>You need a profile before you can search for roommates.</p>
    <a asp-page="/Profile/Create" class="btn btn-primary">Create Profile</a>
}
else if (!Model.ProfileComplete)
{
    <p>Finish filling out your profile to see compatible roommates.</p>
    <a asp-page="/Profile/Edit" class="btn btn-primary">Edit Profile</a>
}
else
{
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label asp-for="MinScore" class="form-label">Minimum compatibility (%)</label>
            <input asp-for="MinScore" type="number" min="0" max="100" step="5" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (Model.Results.Count == 0)
    {
        <p>No compatible roommates found. Try lowering the minimum score.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Compatibility</th>
                    <th>Sleep Schedule</th>
                    <th>Cleanliness</th>
                    <th>Noise Tolerance</th>
                    <th>Smoker</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var match in Model.Results)
                {
                    <tr>
                        <td>@match.Email</td>
                        <td>@match.Score.ToString("0.#")%</td>
                        <td>@(match.SleepSchedule == 1 ? "Very Early 5:00 AM - 6:00 AM" : match.SleepSchedule == 2 ? "Early 6:00 AM - 7:00 AM" : match.SleepSchedule == 3 ? "Average 7:00 AM - 8:00 AM" : match.SleepSchedule == 4 ? "Late 8:00 AM - 9:00 AM" : "Very Late 9:00 AM - 10:00 AM")</td>
                        <td>@(match.Cleanliness == 1 ? "Very Messy" : match.Cleanliness == 2 ? "Messy" : match.Cleanliness == 3 ? "Average" : match.Cleanliness == 4 ? "Clean" : "Very Clean")</td>
                        <td>@(match.NoiseTolerance == 1 ? "Very Sensitive" : match.NoiseTolerance == 2 ? "Somewhat Sensitive" : match.NoiseTolerance == 3 ? "Average sensitivity" : match.NoiseTolerance == 4 ? "Less Sensitive" : "Unbothered by noise")</td>
                        <td>@(match.IsSmoker ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
